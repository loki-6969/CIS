R2 
enable
configure terminal
hostname R2
interface g0/0
 ip address 192.168.2.1 255.255.255.0
 no shutdown
interface s0/0/0
 ip address 10.0.0.2 255.255.255.252
 no shutdown
exit
ip route 192.168.1.0 255.255.255.0 10.0.0.1
crypto isakmp policy 10
 encryption aes 256
 hash sha
 group 2
 lifetime 86400
 exit
crypto isakmp key MyVpnKey123 address 10.0.0.1
crypto ipsec transform-set TS esp-aes 256 esp-sha-hmac
 exit
access-list 110 permit ip 192.168.2.0 0.0.0.255 192.168.1.0 0.0.0.255
crypto map VPN-MAP 10 ipsec-isakmp
 set peer 10.0.0.1
 set transform-set TS
 match address 110
 exit
interface s0/0/0
 crypto map VPN-MAP
end
write memory


R1

enable
configure terminal

hostname R1

interface s0/0/0
 ip address 10.0.0.1 255.255.255.252
 clock rate 64000
 no shutdown
exit

ip route 192.168.2.0 255.255.255.0 10.0.0.2

crypto isakmp policy 10
 encryption aes 256
 hash sha
 authentication pre-share
 group 2
 lifetime 86400
exit

crypto isakmp key MyVpnKey123 address 10.0.0.2

crypto ipsec transform-set TS esp-aes 256 esp-sha-hmac
exit

access-list 110 permit ip 192.168.1.0 0.0.0.255 192.168.2.0 0.0.0.255

crypto map VPN-MAP 10 ipsec-isakmp
 set peer 10.0.0.2
 set transform-set TS
 match address 110
exit

interface s0/0/0
 crypto map VPN-MAP
exit

end
write memory
