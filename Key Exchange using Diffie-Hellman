p = 23 # Prime number
g = 5 # Primitive root
# Alice's private key
a = 6
# Bob's private key
b = 1
# Calculate public keys
A = pow(g, a, p)
B = pow(g, b, p)
print("Public Prime (p):", p)
print("Public Generator (g):", g)
print("\nAlice's Private Key:", a)
print("Alice's Public Key:", A
print("\nBob's Private Key:", b)
print("Bob's Public Key:", B)
# Calculate shared secret key
alice_key = pow(B, a, p)
bob_key = pow(A, b, p)
print("\nAlice's Shared Secret Key:", alice_key)
print("Bob's Shared Secret Key:", bob_key)
# Verify
if alice_key == bob_key:
 print("\nKey Exchange Successful!")
 print("Shared Secret Key:", alice_key)
else:
 print("\nKey Exchange Failed!")
